<Page x:Class="TaskManager.WPF.TaskDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Task Details"
      Background="#F3F4F6">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ViewElement" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EditElement" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <Button Content="Edit" Command="{Binding ToggleEditModeCommand}" Style="{StaticResource ViewElement}" Margin="0,0,10,0" Padding="15,5" Background="#E5E7EB" BorderThickness="0" />
                <Button Content="Save" Command="{Binding SaveTaskCommand}" Style="{StaticResource EditElement}" Margin="0,0,10,0" Padding="15,5" Background="#10B981" Foreground="White" BorderThickness="0" />
                <Button Content="Cancel" Command="{Binding ToggleEditModeCommand}" Style="{StaticResource EditElement}" Margin="0,0,10,0" Padding="15,5" Background="#E5E7EB" BorderThickness="0" />
                <Button Content="Delete" Command="{Binding DeleteTaskCommand}" Padding="15,5" Background="#EF4444" Foreground="White" BorderThickness="0" />
            </StackPanel>

            <TextBlock Text="{Binding Task.Title}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource ViewElement}" />
            <TextBox Text="{Binding Task.Title, UpdateSourceTrigger=PropertyChanged}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Grid.Row="1" Margin="0,0,0,10" Style="{StaticResource EditElement}" />

            <TextBlock Text="{Binding Task.Description}" FontSize="18" Foreground="#4B5563" Grid.Row="2" Margin="0,0,0,15" TextWrapping="Wrap" Style="{StaticResource ViewElement}" />
            <TextBox Text="{Binding Task.Description, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Foreground="#4B5563" Grid.Row="2" Margin="0,0,0,15" TextWrapping="Wrap" Style="{StaticResource EditElement}" AcceptsReturn="True" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Priority: " FontSize="16" FontWeight="SemiBold" Foreground="#374151" />
                <TextBlock Text="{Binding Task.Priority}" FontSize="16" Foreground="#DC2626" FontWeight="Bold" Style="{StaticResource ViewElement}" />
                <TextBox Text="{Binding Task.Priority, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Foreground="#DC2626" FontWeight="Bold" Style="{StaticResource EditElement}" />
            </StackPanel>

            <Button Content="Back" Command="{Binding BackCommand}" Width="160" Height="40" Grid.Row="5" HorizontalAlignment="Left" Margin="0,25,0,0"
                    Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="Medium" BorderThickness="0">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <Grid Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading..." FontSize="24" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>