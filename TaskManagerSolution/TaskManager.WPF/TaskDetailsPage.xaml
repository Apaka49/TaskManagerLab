<Page x:Class="TaskManager.WPF.TaskDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Task Details"
      Background="#F3F4F6">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Task.Title}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Grid.Row="0" Margin="0,0,0,10" />
        <TextBlock Text="{Binding Task.Description}" FontSize="18" Foreground="#4B5563" Grid.Row="1" Margin="0,0,0,15" TextWrapping="Wrap" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Priority: " FontSize="16" FontWeight="SemiBold" Foreground="#374151" />
            <TextBlock Text="{Binding Task.Priority}" FontSize="16" Foreground="#DC2626" FontWeight="Bold" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,25">
            <TextBlock Text="Due Date: " FontSize="16" FontWeight="SemiBold" Foreground="#374151" />
            <TextBlock Text="{Binding Task.DueDate, StringFormat=d}" FontSize="16" Foreground="#4B5563" />
        </StackPanel>

        <Button Content="← Back to Project" Command="{Binding BackCommand}" Width="160" Height="40" Grid.Row="5" HorizontalAlignment="Left" Margin="0,25,0,0" 
                Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="Medium" BorderThickness="0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Page>