<Page x:Class="TaskManager.WPF.ProjectDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Project Details"
      Background="#F3F4F6">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Project.Title}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Grid.Row="0" Margin="0,0,0,10" />
        <TextBlock Text="{Binding Project.Description}" FontSize="18" Foreground="#4B5563" Grid.Row="1" Margin="0,0,0,5" TextWrapping="Wrap" />

        <Border Grid.Row="2" Background="#DBEAFE" HorizontalAlignment="Left" CornerRadius="5" Padding="8,4" Margin="0,5,0,25">
            <TextBlock Text="{Binding Project.Type}" FontSize="14" FontWeight="SemiBold" Foreground="#1E40AF" />
        </Border>

        <TextBlock Text="Tasks" FontSize="24" FontWeight="Bold" Foreground="#1F2937" Grid.Row="3" Margin="0,0,0,15" />

        <Border Grid.Row="4" Background="White" CornerRadius="10" Padding="10">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <ListBox x:Name="TasksList" 
                     ItemsSource="{Binding Tasks}"
                     SelectedItem="{Binding SelectedTask}"
                     DisplayMemberPath="Title" FontSize="16"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Button Content="← Back to Projects" Command="{Binding BackCommand}" Width="160" Height="40" Grid.Row="5" HorizontalAlignment="Left" Margin="0,25,0,0" 
                Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="Medium" BorderThickness="0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Page>