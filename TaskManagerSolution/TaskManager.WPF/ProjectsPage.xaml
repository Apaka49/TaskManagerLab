<Page x:Class="TaskManager.WPF.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Projects"
      Background="#F3F4F6">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="My Projects" FontSize="32" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,20" />

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="10">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <ListBox x:Name="ProjectsList" 
                     ItemsSource="{Binding Projects}"
                     SelectedItem="{Binding SelectedProject}"
                     DisplayMemberPath="Title" 
                     FontSize="18"
                     Foreground="#374151"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,15"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>
    </Grid>
</Page>